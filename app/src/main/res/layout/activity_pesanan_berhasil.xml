<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF">

    <!-- Animasi Gift/Success -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieSuccess"
        android:layout_width="200dp"
        android:layout_height="200dp"
        app:lottie_rawRes="@raw/success_animation"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <!-- Teks Utama -->
    <TextView
        android:id="@+id/textPesanBerhasil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pesanan Anda Berhasil!"
        android:fontFamily="@font/lexenddecabold"
        android:textSize="22sp"
        android:textColor="#1C8D70"
        android:layout_marginTop="16dp" />

    <!-- Subteks -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Terima kasih telah berbelanja di FreshMarket.\nPesanan Anda sedang diproses."
        android:textAlignment="center"
        android:fontFamily="@font/lexenddecaregular"
        android:textSize="14sp"
        android:textColor="#555"
        android:layout_marginTop="8dp" />

    <!-- Tombol -->
    <Button
        android:id="@+id/btnKembaliHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="75dp"
        android:backgroundTint="#1C8D70"
        android:text="Kembali ke Home"
        android:textColor="#FFF"
        android:textSize="16sp"
        android:fontFamily="@font/lexenddecaregular" />
</LinearLayout>
