<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="18dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- CheckBox untuk memilih item -->
        <CheckBox
            android:id="@+id/checkBoxSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:focusable="false"
            android:focusableInTouchMode="false"/>

        <!-- Gambar Produk dengan radius -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardImageProduct"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_toEndOf="@id/checkBoxSelect"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/imageProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Gambar Produk" />
        </androidx.cardview.widget.CardView>

        <!-- Nama Produk -->
        <TextView
            android:id="@+id/textProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/cardImageProduct"
            android:text="Nama Produk"
            android:textColor="#333333"
            android:textSize="18sp"
            android:fontFamily="@font/lexenddecabold" />

        <!-- Harga Produk -->
        <TextView
            android:id="@+id/textProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textProductName"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/cardImageProduct"
            android:layout_marginTop="6dp"
            android:text="Rp 0"
            android:textColor="#1C8D70"
            android:textSize="16sp"
            android:fontFamily="@font/lexenddecasemibold" />

        <!-- Deskripsi Produk -->
        <TextView
            android:id="@+id/textProductDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textProductPrice"
            android:layout_marginStart="16dp"
            android:layout_toEndOf="@id/cardImageProduct"
            android:layout_marginTop="4dp"
            android:text="Produk segar dan sehat"
            android:textColor="#666666"
            android:textSize="10sp"
            android:fontFamily="@font/lexenddecaregular" />

        <!-- Tombol Hapus -->
        <ImageView
            android:id="@+id/buttonDelete"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true"
            android:src="@drawable/baseline_delete_24"
            app:tint="#FF0000"
            android:contentDescription="Hapus" />

        <!-- Layout Plus Minus Quantity -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/textProductDesc"
            android:layout_toEndOf="@id/cardImageProduct"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/buttonDecrease"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/baseline_remove_circle_24"
                app:tint="#1C8D70"
                android:contentDescription="Kurangi" />

            <TextView
                android:id="@+id/textQuantity"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:gravity="center"
                android:text="1"
                android:textSize="18sp"
                android:textColor="#333333"
                android:fontFamily="@font/lexenddecasemibold"
                android:layout_marginHorizontal="8dp" />

            <ImageView
                android:id="@+id/buttonIncrease"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/baseline_add_circle_24"
                app:tint="#1C8D70"
                android:contentDescription="Tambah" />
        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>
